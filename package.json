{
  "name": "claude-code-ssp",
  "version": "0.1.0",
  "description": "Claude Code statusline with a localhost web configurator, widget registry and user plugins",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "bun": ">=1.1" },
  "scripts": {
    "render": "bun run src/cli/main.ts render",
    "serve": "bun run src/cli/main.ts serve",
    "serve:sandbox": "bun run src/cli/main.ts serve --sandbox",
    "dev:web": "bun run --cwd web dev",
    "build:web": "bun run --cwd web build",
    "build": "bun run build:web",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
